pipeline {
    agent any

    environment {
        DB_URL = 'jdbc:oracle:thin:@localhost:1521/XEPDB1'
        DB_USERNAME = 'EARN_WHILE_TRAVEL'
        DB_PASSWORD = 'root'
    }

    stages {
        stage('Cleanup') {
            steps {
                cleanWs() // Forcefully clean workspace before running the job
            }
        }

        stage('Build') {
            steps {
                bat 'mvn clean package -DskipTests' // Windows batch command to build the project
            }
        }

        stage('Run Application') {
            steps {
                bat "java -jar target/demo-0.0.1-SNAPSHOT.jar" // Running the Spring Boot application
            }
        }
    }
}
